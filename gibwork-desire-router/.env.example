GIBWORK_EXPLORE_URL=https://api.gib.work/explore?page=1
GIBWORK_PRODUCTION=true

# Wallet-authenticated SDK actions. Keep secrets local; never commit them.
# GIBWORK_PRIVATE_KEY=<local secret>
# GIBWORK_USDC_MINT=<Solana USDC mint used by your environment>

# Spending remains disabled unless a human explicitly enables it for one execution.
GIBWORK_ALLOW_SPEND=NO
